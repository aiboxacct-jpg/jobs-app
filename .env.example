# --- Supabase (browser-visible) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (server only — never expose to the browser) ---
# SUPABASE_URL is the same project URL as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Feed / cron access ---
# Shared secret sent as the x-feed-key header by the shortlist feed,
# the Friday list feed, and the apply-request watcher.
FEED_API_KEY=generate-a-long-random-string

# --- Site ---
# Public origin of this app, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=https://jobs.mattmyrtle.com
